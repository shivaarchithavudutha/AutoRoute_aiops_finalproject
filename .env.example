# Copy to .env and fill in:  cp .env.example .env
# Run `id -u` and `id -g` in the VM and put the numbers here (so files created by Docker belong to you).
HOST_UID=1000
HOST_GID=1000
# Optional: set a value to require an API key on the gateway (the frontend sends it automatically)
API_KEY=

# Optional security: encrypt the model file stored in MLflow. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Put the SAME key here and in your terminal (export MODEL_ENCRYPTION_KEY=...) before running dvc repro.
MODEL_ENCRYPTION_KEY=
# Optional: start the full pipeline automatically when drift is detected (true/false)
AUTO_RETRAIN_ON_DRIFT=false
