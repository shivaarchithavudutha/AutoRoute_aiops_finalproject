   },
   "gridPos": {
    "x": 0,
    "y": 33,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(process_cpu_seconds_total{job=~\"gateway|trainer\"}[1m])",
     "legendFormat": "{{job}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 18,
   "title": "Automatic retraining triggers",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
