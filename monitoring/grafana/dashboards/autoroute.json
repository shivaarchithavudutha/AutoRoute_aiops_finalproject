{
 "uid": "autoroute",
 "title": "AutoRoute Monitoring",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Predict requests / sec",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(requests_total{endpoint=\"/predict\"}[1m]))",
     "legendFormat": "req/s",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 2,
   "title": "p95 latency (s)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(request_latency_seconds_bucket{endpoint=\"/predict\"}[1m])) by (le))",
     "legendFormat": "p95",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "title": "Error responses / sec (5xx)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(requests_total{status=~\"5..\"}[1m]))",
     "legendFormat": "5xx",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 4,
   "title": "Predictions per class (last 5m)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (category) (increase(predictions_total[5m]))",
     "legendFormat": "{{category}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 5,
   "title": "Median confidence",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum(rate(prediction_confidence_bucket[2m])) by (le))",
     "legendFormat": "median",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 6,
   "title": "Low-confidence predictions (5m)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(low_confidence_total[5m])",
     "legendFormat": "low conf",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 7,
   "title": "Prediction drift (PSI)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "psi_prediction",
     "legendFormat": "PSI",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.25
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "title": "Unknown-word rate (data drift)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "oov_rate",
     "legendFormat": "OOV",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "title": "Text length KS p-value (data drift)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "length_ks_pvalue",
     "legendFormat": "p-value",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 10,
   "title": "Drift buffer ready (1 = yes)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "drift_buffer_ready",
     "legendFormat": "ready",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 11,
   "title": "Model version",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 21,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "model_version",
     "legendFormat": "version",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 12,
   "title": "Component up (1 = up)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 21,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "component_up",
     "legendFormat": "{{component}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 13,
   "title": "Pipeline jobs",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 21,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "trainer_jobs_total",
     "legendFormat": "{{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 14,
   "title": "User-confirmed accuracy (recent feedback)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "feedback_accuracy",
     "legendFormat": "accuracy",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 15,
   "title": "Feedback answers",
   "type": "timeseries",
   "datasource": {
